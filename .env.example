# Optional: Google / YouTube Data API credentials for accessing user account and playlists
# Create a Web application OAuth client and authorize the exact callback URL,
# e.g. http://localhost:3000/auth/callback. Both OAuth values are required.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
YOUTUBE_API_KEY=""
# An API key is for public data; personal library sync requires Google sign-in
# or an OAuth access token with the youtube.readonly scope.

# Optional audio extractor overrides. A project-local .venv/bin/yt-dlp is detected
# automatically; otherwise yt-dlp must be on PATH. Use an up-to-date yt-dlp.
# YTDLP_BINARY="/absolute/path/to/yt-dlp"
# JavaScript runtime for YouTube challenges (Node.js 22+ or Deno 2.3+).
# Defaults to the Node.js executable running the server; Deno on PATH is also detected by yt-dlp.
# YTDLP_JS_RUNTIME="node:/absolute/path/to/node"
